# Copy to .env and adjust. .env is gitignored; .env.example is committed.
# ----------------------------------------------------------------- Mongo
MONGO_ROOT_USER=hungerheal
MONGO_ROOT_PASSWORD=hungerheal_dev_pw
# From the HOST (services run with `npm run dev` / `go run`): port 27018
MONGO_URI_HOST=mongodb://hungerheal:hungerheal_dev_pw@localhost:27018/?authSource=admin
# From INSIDE docker (services run as containers): port 27017 on the compose network
MONGO_URI_DOCKER=mongodb://hungerheal:hungerheal_dev_pw@mongo:27017/?authSource=admin

# ----------------------------------------------------------------- Redis
REDIS_URL_HOST=redis://localhost:6379
REDIS_URL_DOCKER=redis://redis:6379

# ----------------------------------------------------------------- Kafka
KAFKA_BROKERS_HOST=localhost:29092
KAFKA_BROKERS_DOCKER=kafka:9092

# ------------------------------------------------------------------ Auth
# Phase 1. Generate a real one: openssl rand -hex 32
JWT_SECRET=replace_me_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------- Geocoding
# Phase 3. Leave OPENCAGE_API_KEY empty to use the built-in offline geocoder -
# the whole stack works without a key. Set it for real addresses worldwide.
# Free tier (2500 requests/day): https://opencagedata.com/
GEOCODER_PROVIDER=auto
OPENCAGE_API_KEY=
DAILY_REQUEST_QUOTA=2400
