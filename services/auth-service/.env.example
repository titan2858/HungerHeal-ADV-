# auth-service. Copy to .env for running directly on the host with `npm run dev`.
# When run via docker-compose these come from the root .env / compose file instead.
NODE_ENV=development
PORT=4001
SERVICE_NAME=auth-service

# Host access uses port 27018 (the local mongod already owns 27017).
MONGO_URI=mongodb://hungerheal:hungerheal_dev_pw@localhost:27018/?authSource=admin
MONGO_DB_NAME=hh_auth

# Must match every other service that verifies tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=dev_only_secret_change_me_0123456789
JWT_EXPIRES_IN=7d

# Cost factor for bcrypt. 10 is ~100ms per hash: slow enough to make offline
# brute force expensive, fast enough not to stall the login endpoint.
BCRYPT_ROUNDS=10

LOG_LEVEL=info
