# agent-location-service (Go)
NODE_ENV=development
PORT=4004
SERVICE_NAME=agent-location-service

REDIS_URL=redis://localhost:6379

# Must be identical to auth-service's.
JWT_SECRET=dev_only_secret_change_me_0123456789

# Where to fetch an agent's capabilities on their first location report.
AUTH_SERVICE_URL=http://localhost:4001
AUTH_TIMEOUT_SECONDS=5

# How long a reported location stays trusted without a fresh heartbeat.
# Agents should report more often than this - roughly every 15-30s.
AGENT_TTL_SECONDS=120

# How often the reaper sweeps expired agents out of the geo set.
REAP_INTERVAL_SECONDS=60

LOG_LEVEL=info
