# donation-service. Copy to .env for running on the host with `npm run dev`.
NODE_ENV=development
PORT=4002
SERVICE_NAME=donation-service

MONGO_URI=mongodb://hungerheal:hungerheal_dev_pw@localhost:27018/?authSource=admin
MONGO_DB_NAME=hh_donations

# MUST be byte-identical to auth-service's, or every token it issues is rejected.
JWT_SECRET=dev_only_secret_change_me_0123456789

# localhost:29092 from the host, kafka:9092 from inside docker.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=donation-service
KAFKA_ENABLED=true
OUTBOX_SWEEP_INTERVAL_MS=15000

UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_DONATION=5

LOG_LEVEL=info
