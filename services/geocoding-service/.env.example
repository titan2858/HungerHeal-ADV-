# geocoding-service
NODE_ENV=development
PORT=4003
SERVICE_NAME=geocoding-service

# Must be identical to auth-service's.
JWT_SECRET=dev_only_secret_change_me_0123456789

REDIS_URL=redis://localhost:6379

# auto = opencage when a key is set, offline otherwise.
GEOCODER_PROVIDER=auto
# Free key (2500 requests/day) from https://opencagedata.com/
OPENCAGE_API_KEY=
GEOCODER_TIMEOUT_MS=4000

# 30 days: a street address does not move.
CACHE_TTL_SECONDS=2592000
# 1 hour: "not found" may become "found" when the provider updates its data.
NEGATIVE_CACHE_TTL_SECONDS=3600
# Stop short of OpenCage's 2500/day free tier.
DAILY_REQUEST_QUOTA=2400

LOG_LEVEL=info
