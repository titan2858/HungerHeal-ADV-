# assignment-engine (Go) - the matching brain.
# Event-driven: it consumes donation.created and publishes donation.assigned.
NODE_ENV=development
SERVICE_NAME=assignment-engine
# Health endpoint only; there is no request API.
PORT=4005

# Reads the geo/capability/load keys that agent-location-service writes.
REDIS_URL=redis://localhost:6379

# localhost:29092 from the host, kafka:9092 from inside docker.
KAFKA_BROKERS=localhost:29092
# Instances sharing this group split the partitions between them.
KAFKA_CONSUMER_GROUP=assignment-engine

# Must be identical to auth-service's: agents answer offers over HTTP here.
JWT_SECRET=dev_only_secret_change_me_0123456789

# How many agents are offered one donation in parallel.
OFFER_BATCH_SIZE=3

# How many rounds of re-offering before giving up and telling the donor.
MAX_OFFER_ROUNDS=4
# How often expired offers are swept, in seconds.
WATCH_INTERVAL_SECONDS=5
# Cap on candidates scored per radius step.
MAX_CANDIDATES=100

LOG_LEVEL=info
