# tracking-service - owns the donation status lifecycle and timeline.
NODE_ENV=development
PORT=4006
SERVICE_NAME=tracking-service

MONGO_URI=mongodb://hungerheal:hungerheal_dev_pw@localhost:27018/?authSource=admin
# Its own database, separate from donation-service's.
MONGO_DB_NAME=hh_tracking

JWT_SECRET=dev_only_secret_change_me_0123456789
REDIS_URL=redis://localhost:6379

KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=tracking-service
# Its own group, so it receives every event rather than splitting them with
# assignment-engine.
KAFKA_CONSUMER_GROUP=tracking-service
KAFKA_ENABLED=true

DEDUP_TTL_SECONDS=86400
LOG_LEVEL=info
