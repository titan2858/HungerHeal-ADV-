# analytics-service - long-term event history in Cassandra.
#
# Optional: the whole system runs without it. Start it with
#   docker compose --profile analytics up -d
NODE_ENV=development
PORT=4008
SERVICE_NAME=analytics-service

JWT_SECRET=dev_only_secret_change_me_0123456789
REDIS_URL=redis://localhost:6379

CASSANDRA_HOSTS=localhost:9042
CASSANDRA_DATACENTER=datacenter1
CASSANDRA_USER=
CASSANDRA_PASSWORD=

KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=analytics-service
# Its own group: this service was added last and needed no change to any
# producer, because a new consumer group receives the entire stream.
KAFKA_CONSUMER_GROUP=analytics-service
KAFKA_ENABLED=true

DEDUP_TTL_SECONDS=86400
LOG_LEVEL=info
