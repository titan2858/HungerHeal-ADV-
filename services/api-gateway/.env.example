# api-gateway - the single entry point for the frontend.
NODE_ENV=development
PORT=4000
SERVICE_NAME=api-gateway

# The gateway verifies tokens itself, so it shares the secret.
JWT_SECRET=dev_only_secret_change_me_0123456789

AUTH_SERVICE_URL=http://localhost:4001
DONATION_SERVICE_URL=http://localhost:4002
GEOCODING_SERVICE_URL=http://localhost:4003
LOCATION_SERVICE_URL=http://localhost:4004
ENGINE_SERVICE_URL=http://localhost:4005
TRACKING_SERVICE_URL=http://localhost:4006
NOTIFICATION_SERVICE_URL=http://localhost:4007
ANALYTICS_SERVICE_URL=http://localhost:4008

# Generous: a donor posting five photos is a legitimate burst.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Tight: repeated guessing is only useful to an attacker.
AUTH_RATE_LIMIT_MAX=20

PROXY_TIMEOUT_MS=30000
LOG_LEVEL=info
